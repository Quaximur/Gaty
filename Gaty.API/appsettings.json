{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "magic": {
        "ClusterId": "aucy_onion",
        "Match": {
          "Path": "/aucy/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/aucy"
          }
        ]
      }
    },
    "Clusters": {
      "aucy_onion": {
        "HttpRequest": {
          "Version": "2",
          "VersionPolicy": "RequestVersionOrHigher"
        },
        "Destinations": {
          "server": {
            "Address": "http://localhost:7537"
          }
        }
      }
    }
  }
}
