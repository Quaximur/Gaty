{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "magic": {
        "ClusterId": "magic-service",
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "magic-service": {
        "HttpRequest": {
          "Version": "2",
          "VersionPolicy": "RequestVersionOrHigher"
        },
        "Destinations": {
          "server": {
            "Address": "http://localhost:7537"
          }
        }
      }
    }
  }
}
